# Imagen OCI multi-stage compatible con Podman y Docker.

FROM python:3.11-slim AS build
WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/instalacion -r requirements.txt

FROM python:3.11-slim AS runtime
RUN useradd --create-home --uid 10001 abaco
COPY --from=build /instalacion /usr/local
WORKDIR /app
COPY src/ ./src/
COPY datos/ ./datos/
USER abaco
ENV PYTHONPATH=/app/src
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD python3 -c "import urllib.request;urllib.request.urlopen('http://localhost:8000/salud', timeout=2)"
CMD ["uvicorn", "abaco.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
